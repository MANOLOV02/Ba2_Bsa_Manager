<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <Configurations>Debug;Release;Publish</Configurations>
    <Platforms>x64;x86</Platforms>
	<PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ba2_Bsa_Library\BSA_BA2_Library_DLL.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools/Ba2ManagerSaveGate: las leyes de guardado (GuardarConCopia en las cinco ramas) y de
         extraccion (el .dds DX10 sale con cabecera) viven en `GuardadoDeArchive`, que es Friend y asi
         se queda: el gate entra por InternalsVisibleTo y la superficie publica de la app no cambia.
         Ver 00-reglas-self-tests-no-van-en-el-binario. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Ba2ManagerSaveGate</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->
  <Import Project="..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />

  <!-- La configuracion Publish: es Release con carpeta propia. Sin esto compilaria SIN
       OPTIMIZAR, en verde. Ver el comentario del .targets. -->
  <Import Project="..\FO4_Base_Library\ConfiguracionPublish.targets" />

  <!-- Licencias. GPL-3 §4/§5 exige que el texto acompañe al binario, y MIT/Apache-2.0 exigen que
       viaje el aviso de cada componente. Se copian al output para que el paquete salga completo:
       CopyPublish.bat las toma de ahí y CORTA si falta alguna. Ver THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <Content Include="LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE_CREDITS.txt" Link="LICENSE_CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Explicitas, NO un wildcard: `licenses\*.txt` no puede fallar, y un paquete sin los
         textos se distribuiria en infraccion en verde. Un Content que apunta a un archivo
         inexistente da MSB3030 y pone el build en ROJO. Si se agrega una familia de licencia
         nueva, va aca Y en el for de CopyPublish.bat. -->
    <Content Include="licenses\MIT.txt" Link="licenses\MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>